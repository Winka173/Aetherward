{
  // Ascension tiers. Level N applies every module of levels 1..N (cumulative). Modules are authored
  // rules, not only HP inflation. hpPerLevel keeps the launch "+8% enemy HP/damage per level" curve.
  // Module ids: frenzy | enemy_speed | enemy_damage | crystal_max | shop_prices | blocked_node | elite_affix | boss_enrage
  "hpPerLevel": 0.08,
  "levels": [
    { "level": 1, "modules": [ { "id": "frenzy" } ] },
    { "level": 2, "modules": [ { "id": "enemy_speed", "value": 0.08 }, { "id": "shop_prices", "value": 0.15 } ] },
    { "level": 3, "modules": [ { "id": "crystal_max", "value": -0.15 }, { "id": "blocked_node", "value": 1 } ] },
    { "level": 4, "modules": [ { "id": "enemy_damage", "value": 0.1 }, { "id": "elite_affix", "value": 1 } ] },
    { "level": 5, "modules": [ { "id": "boss_enrage", "value": 0.25 } ] }
  ]
}
