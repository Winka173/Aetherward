{
  // Functional battlefields. Each keeps 12 defense nodes and the 6 lane slots the waves reference
  // (0 east, 1 west, 2 north, 3 south, 4 northeast, 5 southwest) but changes geometry and rules.
  // Hazards are always telegraphed (delay) and hit heroes AND enemies; walls/covers never fully block a lane.
  "biomes": [
    { "id": "verdant_sanctuary", "default": true, "arena": "arena", "background": "World/arena_background", "music": "battle_loop" },

    { "id": "molten_crater", "background": "World/bg_molten_crater", "music": "battle_loop",
      // Two narrow basalt bridges: east+northeast and west+southwest share a crossing. Lava vents erupt
      // (telegraphed) every few seconds next to the bridges: standing there is strong but risky.
      "arena": { "id": "molten_crater", "halfWidth": 12.0, "halfHeight": 7.0, "crystalRadius": 0.85,
        "nodes": [ [1.75, 1.45], [-1.75, 1.45], [-1.75, -1.45], [1.75, -1.45],
                   [4.6, 0.7], [3.3, 2.5], [0.0, 3.4], [-3.2, 2.45],
                   [-4.6, -0.7], [-3.3, -2.5], [0.0, -3.4], [3.2, -2.45] ],
        "lanes": [
          { "id": "east",      "points": [[13.0, 1.4], [9.2, 2.4], [6.4, 0.9], [4.0, 0.1], [2.0, 0.0]] },
          { "id": "west",      "points": [[-13.0, -1.4], [-9.2, -2.4], [-6.4, -0.9], [-4.0, -0.1], [-2.0, 0.0]] },
          { "id": "north",     "points": [[-1.4, 8.2], [-0.7, 5.6], [1.2, 4.6], [0.0, 1.9]] },
          { "id": "south",     "points": [[1.4, -8.2], [0.7, -5.6], [-1.2, -4.6], [0.0, -1.9]] },
          { "id": "northeast", "points": [[12.6, 7.6], [9.6, 4.6], [6.4, 0.9], [4.0, 0.1], [2.0, 0.0]] },
          { "id": "southwest", "points": [[-12.6, -7.6], [-9.6, -4.6], [-6.4, -0.9], [-4.0, -0.1], [-2.0, 0.0]] }
        ] },
      "hazards": [ { "kind": "lava_vents", "interval": 9.0, "delay": 1.6, "radius": 1.3, "count": 2, "heroDamagePct": 0.12, "power": 45,
                     "points": [[5.6, 2.6], [-5.6, -2.6], [5.8, -1.8], [-5.8, 1.8], [2.6, 5.4], [-2.6, -5.4]] } ],
      "nodeTraits": [
        { "node": 4, "trait": "heated_bridge", "effects": [ { "op": "stat", "stat": "attack", "value": 0.15, "pct": true } ] },
        { "node": 5, "trait": "heated_bridge", "effects": [ { "op": "stat", "stat": "attack", "value": 0.15, "pct": true } ] },
        { "node": 8, "trait": "heated_bridge", "effects": [ { "op": "stat", "stat": "attack", "value": 0.15, "pct": true } ] },
        { "node": 9, "trait": "heated_bridge", "effects": [ { "op": "stat", "stat": "attack", "value": 0.15, "pct": true } ] } ],
      "extra": [ { "enemy": "flame_devourer", "count": 2, "start": 9.0, "interval": 3.0, "fromWave": 6, "toWave": 14 },
                 { "enemy": "flame_devourer", "count": 3, "start": 7.0, "interval": 2.5, "fromWave": 15, "toWave": 19 } ],
      "bossPools": { "10": ["ignaroth", "gravemaw"] } },

    { "id": "frostfall_bastion", "background": "World/bg_frostfall_bastion", "music": "battle_loop",
