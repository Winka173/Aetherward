                  { "pos": [2.4, 5.4], "radius": 1.0, "hits": 8 }, { "pos": [-2.4, -5.4], "radius": 1.0, "hits": 8 } ],
      "laneSchedule": [ { "lane": 4, "opensAt": 8, "useBefore": 0 }, { "lane": 5, "opensAt": 8, "useBefore": 1 } ],
      "extra": [ { "enemy": "frost_wraith", "count": 2, "start": 8.0, "interval": 3.0, "fromWave": 7, "toWave": 13 },
                 { "enemy": "frost_wraith", "count": 4, "start": 6.0, "interval": 2.0, "fromWave": 14, "toWave": 19 } ],
      "bossPools": { "10": ["seraphyne"] } },

    { "id": "shattered_aether", "background": "World/bg_shattered_aether", "music": "battle_loop",
