      "arena": { "id": "frostfall_bastion", "halfWidth": 12.0, "halfHeight": 7.0, "crystalRadius": 0.85,
        "nodes": [ [1.75, 1.45], [-1.75, 1.45], [-1.75, -1.45], [1.75, -1.45],
                   [4.5, 0.2], [3.2, 2.45], [0.0, 3.35], [-3.2, 2.45],
                   [-4.5, -0.2], [-3.2, -2.45], [0.0, -3.35], [3.2, -2.45] ],
        "lanes": [
          { "id": "east",      "points": [[13.0, 0.0], [9.0, -1.8], [6.0, 0.8], [2.0, 0.0]] },
          { "id": "west",      "points": [[-13.0, 0.0], [-9.0, 1.8], [-6.0, -0.8], [-2.0, 0.0]] },
          { "id": "north",     "points": [[-3.0, 8.2], [-2.2, 5.2], [0.6, 3.9], [0.0, 1.9]] },
          { "id": "south",     "points": [[3.0, -8.2], [2.2, -5.2], [-0.6, -3.9], [0.0, -1.9]] },
          { "id": "northeast", "points": [[12.6, 7.6], [7.4, 6.2], [4.6, 3.4], [1.6, 1.3]] },
          { "id": "southwest", "points": [[-12.6, -7.6], [-7.4, -6.2], [-4.6, -3.4], [-1.6, -1.3]] }
        ] },
      "nodeTraits": [
        { "node": 4, "trait": "frozen_tile", "effects": [ { "op": "stat", "stat": "defense", "value": 0.25, "pct": true }, { "op": "stat", "stat": "attack_interval", "value": -0.12, "pct": true } ] },
        { "node": 8, "trait": "frozen_tile", "effects": [ { "op": "stat", "stat": "defense", "value": 0.25, "pct": true }, { "op": "stat", "stat": "attack_interval", "value": -0.12, "pct": true } ] },
        { "node": 6, "trait": "frozen_tile", "effects": [ { "op": "stat", "stat": "defense", "value": 0.25, "pct": true }, { "op": "stat", "stat": "attack_interval", "value": -0.12, "pct": true } ] },
