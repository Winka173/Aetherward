{
  // Run-only hero traits rolled on recruitment (rarity-weighted, eligibility-checked; starters have none).
  // "effects" are stat ops applied to that hero only. "behaviour" keys are read by combat (Battle.Traits.cs);
  // a trait never changes the hero's element, role or skill kind. Traits reset with the run.
  "traits": [
    { "id": "pyromaniac", "rarity": "rare", "requires": { "element": "fire" },
      "effects": [ { "op": "stat", "stat": "status_power", "value": 0.3 } ],
      "behaviour": { "burnDuration": 0.5, "burningBonus": 0.2 } },
    { "id": "twin_caster", "rarity": "epic", "requires": { "roles": ["mage", "support", "healer", "controller"] },
      "behaviour": { "echoChance": 0.25, "echoPower": 0.5, "echoCooldown": 6.0 } },
    { "id": "elementalist", "rarity": "rare",
      "effects": [ { "op": "stat", "stat": "elemental_mastery", "value": 60 } ],
      "behaviour": { "gaugeBonus": 0.2 } },
    { "id": "guardians_soul", "rarity": "rare", "requires": { "roles": ["guardian", "bruiser"] },
      "effects": [ { "op": "stat", "stat": "threat", "value": 0.8 }, { "op": "stat", "stat": "damage_reduction", "value": 0.08 } ] },
    { "id": "quick_channel", "rarity": "common",
      "effects": [ { "op": "stat", "stat": "skill_cooldown", "value": 0.15, "pct": true }, { "op": "stat", "stat": "max_hp", "value": -0.1, "pct": true } ] },
    { "id": "steadfast", "rarity": "common",
      "effects": [ { "op": "stat", "stat": "defense", "value": 8 }, { "op": "stat", "stat": "max_hp", "value": 0.1, "pct": true } ],
      "behaviour": { "debuffImmune": 1 } },
    { "id": "fragile_genius", "rarity": "rare", "requires": { "roles": ["mage", "support", "healer", "controller", "ranger"] },
      "effects": [ { "op": "stat", "stat": "skill_power", "value": 0.25, "pct": true }, { "op": "stat", "stat": "max_hp", "value": -0.2, "pct": true } ] },
    { "id": "efficient_ward", "rarity": "common", "requires": { "roles": ["guardian", "healer", "support"] },
      "behaviour": { "shieldBonus": 0.25, "healBonus": 0.15 } },
    { "id": "last_stand", "rarity": "rare",
      "behaviour": { "lowHpThreshold": 0.35, "lowHpBonus": 0.35 } },
    { "id": "executioner", "rarity": "rare", "requires": { "roles": ["assassin", "ranger", "bruiser", "mage"] },
      "behaviour": { "executeBelow": 0.25, "executeBonus": 0.4 } },
    { "id": "tactician", "rarity": "epic",
      "behaviour": { "allyHaste": 0.08, "allyRadius": 3.0 } },
    { "id": "arcane_reservoir", "rarity": "rare", "requires": { "roles": ["mage", "support", "controller", "healer"] },
      "effects": [ { "op": "stat", "stat": "elemental_mastery", "value": 20 } ],
      "behaviour": { "instantFirstCast": 1 } }
  ]
}
