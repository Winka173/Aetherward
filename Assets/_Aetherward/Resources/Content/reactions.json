    { "id": "vaporize",      "a": "fire",      "b": "water",     "base": 14, "attackScale": 0.9, "radius": 1.0, "duration": 0,   "consume": 1.0, "cooldown": 0.6, "params": { "mult": 2.2, "splash": 0.4 } },
