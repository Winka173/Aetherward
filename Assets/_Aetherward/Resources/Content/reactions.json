  // Pairs that coexist without reacting (both auras and their statuses stay active).
  "neutral": [
    { "a": "light", "b": "poison", "reason": "light_poison" },
    { "a": "earth", "b": "nature", "reason": "earth_nature" },
    { "a": "earth", "b": "poison", "reason": "earth_poison" }
  ],
  "blocked": [],

  // Template for every remaining primary pair: a small burst of both elements, named "A·B burst".
